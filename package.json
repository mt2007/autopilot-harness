{
  "name": "autopilot-harness",
  "version": "0.2.1",
  "private": true,
  "description": "Project-level agent harness: Planning → Executing with review chains",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "bundle-vendor": "pnpm --filter @autopilot-harness/cli run bundle-vendor",
    "test": "pnpm run bundle-vendor && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}

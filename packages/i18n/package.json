{
  "name": "@autopilot-harness/i18n",
  "version": "0.1.0",
  "description": "Autopilot harness locale strings (en, zh-CN)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mt2007/autopilot-harness.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/mt2007/autopilot-harness#readme",
  "bugs": {
    "url": "https://github.com/mt2007/autopilot-harness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": "./locales/*"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

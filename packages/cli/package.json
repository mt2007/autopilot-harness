{
  "name": "@autopilot-harness/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "autopilot-harness": "./dist/bin.js"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "assets",
    "src"
  ],
  "scripts": {
    "bundle-vendor": "node ./scripts/bundle-vendor.mjs",
    "build": "node ./scripts/bundle-vendor.mjs && tsc -p tsconfig.json && rm -rf dist/assets && cp -R assets dist/assets",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autopilot-harness/core": "workspace:*",
    "@autopilot-harness/i18n": "workspace:*",
    "@autopilot-harness/port-cursor": "workspace:*",
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}

# Dependencies
node_modules/
dist/

# Autopilot (local dogfood — init per machine; not shipped in OSS)
plans/
.autopilot/
# Ignore dogfood .cursor contents, but keep project rules versioned
.cursor/*
!.cursor/rules/
!.cursor/rules/**
# Autopilot dogfood workflows under docs/autopilot (init per machine)
# Keep user-facing quickstart tracked for OSS README links
docs/autopilot/*
!docs/autopilot/quickstart.md

# Environment
.env
.env.local
.env.*.local

# IDE / OS
.idea/
.vscode/
.DS_Store

# Test / coverage
coverage/
*.log

# Autopilot runtime
.autopilot/state.db
.autopilot/state.db-*
.autopilot/state.db.bak*
.autopilot/worktrees/
.autopilot/verify-last.json
.autopilot/logs/

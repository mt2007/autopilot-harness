# Dependencies
node_modules/
dist/

# Autopilot (local dogfood — init per machine; not shipped in OSS)
plans/
.autopilot/
# Ignore dogfood .cursor contents, but keep project rules versioned
.cursor/*
!.cursor/rules/
!.cursor/rules/**
# Claude Code Autopilot install residue (settings/skills); not shipped in OSS
.claude/
# Autopilot dogfood workflows under docs/autopilot (init per machine)
# Keep user-facing quickstarts tracked for OSS README links
docs/autopilot/*
!docs/autopilot/quickstart.md
!docs/autopilot/quickstart.zh-CN.md

# Environment
.env
.env.local
.env.*.local

# IDE / OS
.idea/
.vscode/
.DS_Store

# Test / coverage
coverage/
*.log

# CLI sync-dist-assets crash leftovers (must stay outside published dist/)
packages/cli/.assets-staging-*
packages/cli/.assets-old-*
packages/cli/.assets-blocking-*

# Autopilot runtime
.autopilot/state.db
.autopilot/state.db-*
.autopilot/state.db.bak*
.autopilot/worktrees/
.autopilot/verify-last.json
.autopilot/logs/
